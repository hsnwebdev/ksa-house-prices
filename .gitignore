# ── data: never commit it ──────────────────────────────────────────
# The raw CSVs are ~162 MB and the parquet is ~18 MB. Git stores every
# version of every file for ever, so a data file committed once is in
# the repo's history permanently, even after you delete it.
# build_dataset.py regenerates all of it from the public source.
raw/
data/
out/*.parquet
out/*.csv
*.parquet

# ── notebooks ──────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── python environments ────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
envs/
.conda/
.env

# ── os / editor ────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
